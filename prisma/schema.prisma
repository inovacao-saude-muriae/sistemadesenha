generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model profiles {
  id          String        @id @db.Uuid
  username    String?       @unique
  full_name   String
  role        user_role?    @default(attendant)
  sector_id   String?
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  sectors     sectors?      @relation(fields: [sector_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  queue_calls queue_calls[]
}

model queue_calls {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sector_id  String
  number_str String     @db.VarChar(4)
  number_int Int
  type       queue_type
  called_by  String?    @db.Uuid
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  profiles   profiles?  @relation(fields: [called_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sectors    sectors    @relation(fields: [sector_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model queue_counters {
  sector_id      String    @id
  current_number Int?      @default(0)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  sectors        sectors   @relation(fields: [sector_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model sectors {
  id             String          @id
  name           String
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  profiles       profiles[]
  queue_calls    queue_calls[]
  queue_counters queue_counters?
}

enum queue_type {
  normal
  preferential
}

enum user_role {
  admin
  attendant
}

model news {
  id         BigInt    @id @default(autoincrement())
  title      String
  image_url  String
  active     Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}